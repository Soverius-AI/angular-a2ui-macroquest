{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular-a2ui-macroquest": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/material-theme.scss",
              "node_modules/@copilotkit/angular/dist/styles.css",
              "src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "@jetbrains/websandbox",
              "chalk",
              "node-fetch",
              "partial-json"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4MB",
                  "maximumError": "6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "byok": {
              "browser": "src/main.byok.ts",
              "fileReplacements": [
                {
                  "replace": "src/app/runtime-url.ts",
                  "with": "src/app/runtime-url.byok.ts"
                }
              ],
              "assets": [
                { "glob": "**/*", "input": "public" },
                { "glob": "byok-sw.js", "input": "tmp/byok", "output": "/" },
                {
                  "glob": "**/*",
                  "input": "tmp/byok/byok",
                  "output": "/byok/"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "byok": {
              "buildTarget": "angular-a2ui-macroquest:build:development,byok"
            },
            "production": {
              "buildTarget": "angular-a2ui-macroquest:build:production"
            },
            "development": {
              "buildTarget": "angular-a2ui-macroquest:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
