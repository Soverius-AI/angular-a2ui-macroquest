{
  "name": "angular-a2ui-macroquest",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:ui": "ng serve",
    "start:runtime": "COPILOTKIT_TELEMETRY_DISABLED=true TMPDIR=/private/tmp tsx watch server/index.ts",
    "start:llama": "scripts/start-llama-server.sh",
    "start:all": "concurrently -k -n llama,runtime,ui -c magenta,blue,green \"pnpm run start:llama\" \"pnpm run start:runtime\" \"pnpm run start:ui\"",
    "start:all:openrouter": "COPILOT_MODEL_PROVIDER=openrouter concurrently -k -n runtime,ui -c blue,green \"pnpm run start:runtime\" \"pnpm run start:ui\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:integration": "playwright test --config playwright.config.ts"
  },
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@copilotkit/angular": "^0.5.3",
    "@copilotkit/runtime": "^1.79.0",
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zod3": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "pnpm": {
    "overrides": {
      "rxjs": "7.8.2"
    }
  }
}
